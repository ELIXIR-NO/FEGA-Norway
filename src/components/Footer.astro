---
// Adds the built commit under Starlight's own footer, so a reader can tell which
// revision of the source produced the page they are looking at. lastUpdated
// dates the content; this dates the build.
import Default from '@astrojs/starlight/components/Footer.astro';
import { commit, shortCommit } from '../lib/build-info';

const commitUrl = `https://github.com/ELIXIR-NO/FEGA-Norway/commit/${commit}`;
---

<Default {...Astro.props}><slot /></Default>
{
	commit && (
		<p class="build-info">
			Built from <a href={commitUrl}><code>{shortCommit}</code></a>
		</p>
	)
}

<style>
	.build-info {
		margin: 1.5rem auto 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.build-info a {
		color: inherit;
		text-decoration: none;
	}
	.build-info a:hover {
		color: var(--sl-color-white);
	}
	.build-info code {
		font-size: inherit;
	}
</style>
